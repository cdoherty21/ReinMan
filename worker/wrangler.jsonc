{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rein-man",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  // The React app is served from the same Worker so every request (pages and API)
  // passes through the authentication check first.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rein-man",
      // Replace with the id printed by: npx wrangler d1 create rein-man
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // Every 5 minutes: lock final pre-post selections and, when the card calls for it, start
  // the GitHub Actions "monitor" workflow (worker/src/schedule.ts: just before posts, a
  // warm-up before the first race, results sweeps). MONITOR_MIN_GAP_MIN spaces pre-post
  // checks to fit the free Actions minutes of a private repository.
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    // "false" = email + password login (secrets REINMAN_EMAIL, REINMAN_PASSWORD, SESSION_SECRET,
    // and RESEND_API_KEY for reset emails). "true" = no login: anyone with the link can use the app.
    "AUTH_DISABLED": "false",
    "GITHUB_REPO": "cdoherty21/ReinMan",
    "GITHUB_WORKFLOW": "reinman-monitor.yml",
    "GITHUB_REF": "main",
    "MONITOR_MIN_GAP_MIN": "20"
  },
  "keep_vars": true,
  "observability": { "enabled": true }
}
